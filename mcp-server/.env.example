MOA_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MOA_SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-or-service-role-key
# STDIO 전용. HTTP 모드에서는 MOA_MCP_TOKENS가 사용자를 정합니다.
MOA_MCP_USER_ID=00000000-0000-0000-0000-000000000000
# HTTP: token:auth-uuid  토큰은 16자 이상. Cursor의 MOA_MCP_TOKEN과 왼쪽 값이 같아야 합니다.
MOA_MCP_TOKENS=replace-with-16-char-token:00000000-0000-0000-0000-000000000000
MOA_MCP_HTTP_HOST=127.0.0.1
MOA_MCP_HTTP_PORT=8787
# MOA_MCP_HTTP_ORIGINS=http://127.0.0.1:8787
